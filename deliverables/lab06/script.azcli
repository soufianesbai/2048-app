$subscriptionId="<subscription-id>"
$tenantId="<tenant-id>"

az login --tenant $tenantId
az account set -s $subscriptionId

# Créer les ressources pour QA et Production
foreach ($env in @("qa", "prod")) {
    $rgName = "rg-vue2048-$env"
    $swaName = "stapp-vue2048-$env"

    Write-Host "=== Création de l'environnement $env ==="

    # Groupe de ressources
    az group create -n $rgName -l "France Central" --tags Class=EI8IT213

    # Azure Static Web App (plan Free)
    az staticwebapp create -n $swaName -g $rgName --sku Free

    # Récupération du deployment token (à ajouter dans les secrets GitHub/GitLab)
    Write-Host "Deployment token pour $env :"
    az staticwebapp secrets list -n $swaName -g $rgName --query "properties.apiKey" -o tsv
}
